<!-- Tabs Script -->
<script>
  function toggleSystemTab(systemId) {
    // Hide all panels
    document.querySelectorAll('.system-panel').forEach(p => p.classList.add('hidden'));
    // Show current panel
    document.getElementById('panel-' + systemId).classList.remove('hidden');

    // Reset tab card styling
    document.querySelectorAll('.tab-card').forEach(tab => {
      tab.className = "tab-card bg-surface-container-lowest ghost-border rounded-lg p-6 cursor-pointer hover:bg-surface-container-high transition-all duration-300";
      tab.querySelector('.indicator').classList.add('hidden');
      
      const categoryTag = tab.querySelector('.font-mono-label');
      categoryTag.className = "font-mono-label text-mono-label text-slate-gray uppercase block mb-2 font-bold tracking-wider";
      
      const titleTag = tab.querySelector('h3');
      titleTag.className = "font-headline-md text-body-lg font-bold text-slate-gray mb-1";
    });

    // Style active tab
    const activeTab = document.getElementById('tab-' + systemId);
    activeTab.className = "tab-card bg-surface-container-lowest border border-electric-blue rounded-lg p-6 cursor-pointer shadow-sm relative transition-all duration-300";
    activeTab.querySelector('.indicator').classList.remove('hidden');

    const activeCategory = activeTab.querySelector('.font-mono-label');
    activeCategory.className = "font-mono-label text-mono-label text-electric-blue uppercase block mb-2 font-bold tracking-wider";

    const activeTitle = activeTab.querySelector('h3');
    activeTitle.className = "font-headline-md text-body-lg font-bold text-deep-charcoal mb-1";
  }
</script>

