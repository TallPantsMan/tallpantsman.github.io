<script>
  function switchTab(tabId) {
    // Hide all panels
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.add('hidden'));
    // Show active panel
    document.getElementById('panel-' + tabId).classList.remove('hidden');

    // Reset all buttons style
    document.querySelectorAll('.tab-control-btn').forEach(btn => {
      btn.className = "tab-control-btn text-left p-6 rounded-2xl border border-glass-stroke transition-all duration-300 bg-transparent text-on-surface-variant hover:bg-surface-gray cursor-pointer";
      btn.querySelector('.font-label-caps').className = "font-label-caps text-[10px] text-on-surface-variant/60 font-bold tracking-wider mb-2";
    });

    // Style active button
    const activeBtn = document.getElementById('btn-' + tabId);
    activeBtn.className = "tab-control-btn text-left p-6 rounded-2xl border transition-all duration-300 bg-white border-brand-indigo text-primary shadow-sm cursor-pointer";
    activeBtn.querySelector('.font-label-caps').className = "font-label-caps text-[10px] text-brand-indigo font-bold tracking-wider mb-2";
  }
</script>

