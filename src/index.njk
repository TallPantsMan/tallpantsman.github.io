<!-- Tabs Script -->
<script>
  function toggleSystemTab(systemId) {
    document.querySelectorAll('.system-panel').forEach(p => {
      p.classList.add('hidden');
      p.classList.remove('animate-fade-in');
    });

    const activePanel = document.getElementById('panel-' + systemId);
    if (activePanel) {
      activePanel.classList.remove('hidden');
      activePanel.classList.add('animate-fade-in');
    }

    document.querySelectorAll('.tab-card').forEach(tab => {
      tab.classList.remove('border-2', 'border-electric-blue', 'shadow-sm');
      tab.classList.add('border', 'border-outline-variant/60');
      
      const indicator = tab.querySelector('.indicator');
      if (indicator) indicator.classList.add('hidden');

      const categoryTag = tab.querySelector('.tab-category');
      if (categoryTag) {
        categoryTag.classList.remove('text-electric-blue');
        categoryTag.classList.add('text-slate-gray');
      }

      const titleTag = tab.querySelector('.tab-title');
      if (titleTag) {
        titleTag.classList.remove('text-deep-charcoal');
        titleTag.classList.add('text-slate-gray');
      }
    });

    const activeTab = document.getElementById('tab-' + systemId);
    if (activeTab) {
      activeTab.classList.remove('border', 'border-outline-variant/60');
      activeTab.classList.add('border-2', 'border-electric-blue', 'shadow-sm');
      
      const indicator = activeTab.querySelector('.indicator');
      if (indicator) indicator.classList.remove('hidden');

      const categoryTag = activeTab.querySelector('.tab-category');
      if (categoryTag) {
        categoryTag.classList.remove('text-slate-gray');
        categoryTag.classList.add('text-electric-blue');
      }

      const titleTag = activeTab.querySelector('.tab-title');
      if (titleTag) {
        titleTag.classList.remove('text-slate-gray');
        titleTag.classList.add('text-deep-charcoal');
      }
    }
  }
</script>

