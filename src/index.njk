<!-- Calculator Interactive Script -->
<script>
(function() {
  const teamInput = document.getElementById('calc-team');
  const hoursInput = document.getElementById('calc-hours');
  const rateInput = document.getElementById('calc-rate');
  const displayTeam = document.getElementById('display-team');
  const displayHours = document.getElementById('display-hours');
  const displayRate = document.getElementById('display-rate');
  const resultHours = document.getElementById('result-hours');
  const resultCost = document.getElementById('result-cost');
  const ctaBtn = document.getElementById('calc-cta-btn');
  const form = document.getElementById('calc-quick-form');
  const emailInput = document.getElementById('calc-email');
  const submitBtn = document.getElementById('calc-submit-btn');
  const feedback = document.getElementById('calc-feedback');

  function update() {
    if (!teamInput || !hoursInput || !rateInput) return;
    const team = parseFloat(teamInput.value);
    const hours = parseFloat(hoursInput.value);
    const rate = parseFloat(rateInput.value);

    displayTeam.textContent = team + ' people';
    displayHours.textContent = hours + ' hrs/wk';
    displayRate.textContent = '$' + rate + ' / hr';

    const monthlyHours = Math.round(team * hours * 4.33);
    const annualCost = Math.round(monthlyHours * 12 * rate);

    resultHours.textContent = monthlyHours.toLocaleString() + ' hrs/mo';
    resultCost.textContent = '$' + annualCost.toLocaleString() + '/yr';

    if (ctaBtn) {
      ctaBtn.href = '/contact/?team=' + team + '&hours=' + hours + '&cost=' + annualCost;
    }
  }

  if (teamInput && hoursInput && rateInput) {
    teamInput.addEventListener('input', update);
    hoursInput.addEventListener('input', update);
    rateInput.addEventListener('input', update);
    update();
  }

  if (form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      const email = emailInput.value.trim();
      if (!email) return;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Saving...';

      const team = teamInput.value;
      const hours = hoursInput.value;
      const rate = rateInput.value;
      const monthlyHours = Math.round(team * hours * 4.33);
      const annualCost = Math.round(monthlyHours * 12 * rate);

      const payload = {
        apiKey: 'caulhaus_sec_2026_x89',
        action: 'inbound_lead',
        name: 'Calculator Lead (' + email.split('@')[0] + ')',
        email: email,
        company: email.split('@')[1] || 'Website Lead',
        domain: email.split('@')[1] || 'unknown',
        source: 'Homepage Hero Calculator',
        frictionSummary: 'Team: ' + team + ' FTEs | Hours: ' + hours + 'h/wk | Est. Cost: $' + annualCost.toLocaleString(),
        message: 'Visitor ran calculation: ' + team + ' FTEs spending ' + hours + ' hrs/wk on manual staffing/status tasks at $' + rate + '/hr = ' + monthlyHours + ' hrs/mo ($' + annualCost.toLocaleString() + '/yr est. capacity cost).'
      };

      fetch('https://script.google.com/macros/s/AKfycbwF-blXk8RZ8EHU_Oli9ilCp_PaRutCrxlAOpvGj_0PCfO-9IRPBsWM8HMVMFNEyEE/exec', {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      }).then(function() {
        form.classList.add('hidden');
        feedback.classList.remove('hidden');
        feedback.innerHTML = '<span class=\"text-emerald-600 font-bold\">&check;</span> Calculation saved! Check your inbox shortly.';
      }).catch(function() {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Summary';
        feedback.classList.remove('hidden');
        feedback.textContent = 'Saved! Redirecting to contact...';
        setTimeout(function() {
          window.location.href = ctaBtn.href;
        }, 1000);
      });
    });
  }
})();
</script>

