<!-- Multi-Step Wizard Script -->
<script>
  let currentStep = 1;
  const totalSteps = 3;

  const prevBtn = document.getElementById('prev-btn');
  const nextBtn = document.getElementById('next-btn');
  const submitBtn = document.getElementById('submit-btn');

  function showStep(stepNum) {
    document.querySelectorAll('.wizard-step').forEach(step => step.classList.add('hidden'));
    document.getElementById('wizard-step-' + stepNum).classList.remove('hidden');

    if (stepNum === 1) {
      prevBtn.classList.add('hidden');
    } else {
      prevBtn.classList.remove('hidden');
    }

    if (stepNum === totalSteps) {
      nextBtn.classList.add('hidden');
      submitBtn.classList.remove('hidden');
    } else {
      nextBtn.classList.remove('hidden');
      submitBtn.classList.add('hidden');
    }
  }

  nextBtn.addEventListener('click', () => {
    // Validation before going from Step 1 to 2
    if (currentStep === 1) {
      // Step 1 uses radio buttons which always have one selected, so it's always valid
    }
    // Validation before going from Step 2 to 3
    if (currentStep === 2) {
      // Step 2 uses radio buttons, always valid
    }

    if (currentStep < totalSteps) {
      currentStep++;
      showStep(currentStep);
    }
  });

  prevBtn.addEventListener('click', () => {
    if (currentStep > 1) {
      currentStep--;
      showStep(currentStep);
    }
  });

  // Highlight chosen objective/CRM cards
  document.querySelectorAll('input[name="objective"]').forEach(input => {
    input.addEventListener('change', () => {
      document.querySelectorAll('input[name="objective"]').forEach(i => {
        i.closest('label').className = i.checked 
          ? "flex items-center gap-4 p-4 rounded-xl border border-brand-indigo bg-brand-indigo/5 cursor-pointer transition-all"
          : "flex items-center gap-4 p-4 rounded-xl border border-glass-stroke hover:bg-surface-gray cursor-pointer transition-all";
      });
    });
  });

  document.querySelectorAll('input[name="crm"]').forEach(input => {
    input.addEventListener('change', () => {
      document.querySelectorAll('input[name="crm"]').forEach(i => {
        i.closest('label').className = i.checked 
          ? "flex items-center gap-3 p-4 rounded-xl border border-brand-indigo bg-brand-indigo/5 cursor-pointer transition-all"
          : "flex items-center gap-3 p-4 rounded-xl border border-glass-stroke hover:bg-surface-gray cursor-pointer transition-all";
      });
    });
  });

  // Submitting the wizard
  const form = document.getElementById('contact-wizard-form');
  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Final checks before submitting
    const name = document.querySelector('input[name="name"]');
    const email = document.querySelector('input[name="email"]');
    const website = document.querySelector('input[name="website"]');
    if (!name.value || !email.value || !website.value) {
      alert('Please fill out all contact fields before submitting.');
      return;
    }
    if (!email.checkValidity()) {
      alert('Please enter a valid email address.');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting...';

    const formData = new FormData(form);
    const object = Object.fromEntries(formData);
    const json = JSON.stringify(object);

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: json
      });
      const result = await response.json();
      if (result.success) {
        document.getElementById('success-overlay').classList.remove('hidden');
      } else {
        throw new Error('Web3Forms returned failure');
      }
    } catch (err) {
      console.error(err);
      // Fallback mailto link
      const mailtoLink = `mailto:alex@caulhaus.com?subject=Operations Audit Request&body=Objective: ${object.objective}%0D%0ACustomer Database: ${object.crm}%0D%0AName: ${object.name}%0D%0AWebsite: ${object.website}%0D%0ALeads: ${object.leads}`;
      alert('There was a connection issue. We are opening your email client to submit details directly!');
      window.location.href = mailtoLink;
      submitBtn.disabled = false;
      submitBtn.textContent = 'Submit Details';
    }
  });

  // Init
  document.addEventListener('DOMContentLoaded', () => {
    // Initial card classes triggers
    document.querySelectorAll('input[name="objective"]').forEach(i => {
      if(i.checked) i.closest('label').className = "flex items-center gap-4 p-4 rounded-xl border border-brand-indigo bg-brand-indigo/5 cursor-pointer transition-all";
    });
    document.querySelectorAll('input[name="crm"]').forEach(i => {
      if(i.checked) i.closest('label').className = "flex items-center gap-3 p-4 rounded-xl border border-brand-indigo bg-brand-indigo/5 cursor-pointer transition-all";
    });
    showStep(1);
  });
</script>
