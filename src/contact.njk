<!-- Multi-Step Wizard Script -->
<script>
  let currentStep = 1;
  const totalSteps = 3;

  const prevBtn = document.getElementById('prev-btn');
  const nextBtn = document.getElementById('next-btn');
  const submitBtn = document.getElementById('submit-btn');
  const stepIndicatorText = document.getElementById('step-indicator-text');
  const stepPercentage = document.getElementById('step-percentage');
  const stepProgressBar = document.getElementById('step-progress-bar');

  function updateProgressBar(stepNum) {
    const pct = Math.round((stepNum / totalSteps) * 100);
    if (stepIndicatorText) stepIndicatorText.textContent = `STEP ${stepNum} OF ${totalSteps}`;
    if (stepPercentage) stepPercentage.textContent = `${pct}%`;
    if (stepProgressBar) stepProgressBar.style.width = `${pct}%`;
  }

  function showStep(stepNum) {
    document.querySelectorAll('.wizard-step').forEach(step => {
      step.classList.add('hidden');
      step.classList.remove('animate-fade-in');
    });

    const activeStepEl = document.getElementById('wizard-step-' + stepNum);
    if (activeStepEl) {
      activeStepEl.classList.remove('hidden');
      activeStepEl.classList.add('animate-fade-in');
    }

    updateProgressBar(stepNum);

    if (stepNum === 1) {
      prevBtn.classList.add('hidden');
    } else {
      prevBtn.classList.remove('hidden');
    }

    if (stepNum === totalSteps) {
      nextBtn.classList.add('hidden');
      submitBtn.classList.remove('hidden');
    } else {
      nextBtn.classList.remove('hidden');
      submitBtn.classList.add('hidden');
    }
  }

  nextBtn.addEventListener('click', () => {
    if (currentStep < totalSteps) {
      currentStep++;
      showStep(currentStep);
    }
  });

  prevBtn.addEventListener('click', () => {
    if (currentStep > 1) {
      currentStep--;
      showStep(currentStep);
    }
  });

  function updateRadioClasses(name) {
    document.querySelectorAll(`input[name="${name}"]`).forEach(input => {
      const label = input.closest('label');
      if (label) {
        if (input.checked) {
          label.className = "wizard-option-card flex items-center gap-4 p-4 rounded-xl border-2 border-brand-indigo bg-brand-indigo/5 cursor-pointer transition-all focus-within:ring-2 focus-within:ring-brand-indigo/30";
        } else {
          label.className = "wizard-option-card flex items-center gap-4 p-4 rounded-xl border border-outline-variant/40 hover:bg-surface-gray cursor-pointer transition-all focus-within:ring-2 focus-within:ring-brand-indigo/30";
        }
      }
    });
  }

  document.querySelectorAll('input[name="objective"]').forEach(input => {
    input.addEventListener('change', () => updateRadioClasses('objective'));
  });

  document.querySelectorAll('input[name="crm"]').forEach(input => {
    input.addEventListener('change', () => updateRadioClasses('crm'));
  });

  const form = document.getElementById('contact-wizard-form');
  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const name = document.querySelector('input[name="name"]');
    const email = document.querySelector('input[name="email"]');
    const website = document.querySelector('input[name="website"]');
    if (!name.value || !email.value || !website.value) {
      alert('Please fill out all contact fields before submitting.');
      return;
    }
    if (!email.checkValidity()) {
      alert('Please enter a valid email address.');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting...';

    const formData = new FormData(form);
    const object = Object.fromEntries(formData);
    const json = JSON.stringify(object);

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: json
      });
      const result = await response.json();
      if (result.success) {
        document.getElementById('success-overlay').classList.remove('hidden');
      } else {
        throw new Error('Web3Forms returned failure');
      }
    } catch (err) {
      console.error(err);
      const mailtoLink = `mailto:alex@caulhaus.com?subject=Systems Audit Request&body=Goal: ${object.objective}%0D%0ATools: ${object.crm}%0D%0AName: ${object.name}%0D%0AWebsite: ${object.website}%0D%0ATeam Size: ${object.leads}`;
      alert('There was a connection issue. We are opening your email client to submit details directly!');
      window.location.href = mailtoLink;
      submitBtn.disabled = false;
      submitBtn.textContent = 'Submit Details';
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    updateRadioClasses('objective');
    updateRadioClasses('crm');
    showStep(1);
  });
</script>
