---
layout: base.njk
title: Business Systems & Automation Guides | CaulHaus
description: Plain English, step-by-step guides on connecting your software, tracking where leads come from, and automating daily work.
---

<section class="py-20 max-w-[1024px] mx-auto px-6 md:px-16 relative reveal">
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    <div class="ambient-glow top-1/4 left-1/4"></div>
  </div>
  
  <div class="max-w-3xl mx-auto text-center mb-20 relative z-10">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-brand-indigo/30 bg-brand-indigo/5 text-brand-indigo text-xs font-semibold uppercase tracking-wider mb-6">
      Operations Insights
    </div>
    <h1 class="font-display-sm text-display-sm md:font-display-lg md:text-display-lg text-primary mb-4 font-bold">Systems &amp; Automation Guides</h1>
    <p class="font-body-lg text-body-lg text-on-surface-variant font-light">Simple, step-by-step guides on connecting your software, tracking where leads come from, and automating daily work.</p>
  </div>

  <!-- Blog Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 relative z-10">
    {%- for post in collections.blog | reverse -%}
      <article class="glass-card rounded-3xl overflow-hidden border border-outline-variant/50 flex flex-col justify-between hover:-translate-y-1 hover:shadow-xl hover:shadow-primary/5 transition-all duration-300">
        <div class="p-8">
          <div class="flex items-center gap-3 text-xs text-on-surface-variant/60 font-semibold mb-4 uppercase tracking-wider">
            <span>{{ post.date | readableDate }}</span>
            <span>•</span>
            <span>{{ post.data.readTime or "3 min" }} read</span>
          </div>
          
          <h2 class="font-headline-md text-xl text-on-surface mb-3 hover:text-primary transition-colors line-clamp-2 font-semibold">
            <a href="{{ post.url }}">{{ post.data.title }}</a>
          </h2>
          
          <p class="font-body-md text-sm text-on-surface-variant line-clamp-3 mb-6 font-light leading-relaxed">
            {{ post.data.description }}
          </p>
        </div>
        
        <div class="p-8 pt-6 border-t border-outline-variant/30 flex items-center justify-between">
          <span class="text-xs text-on-surface-variant/60 font-mono">By {{ post.data.author or "Alex Herbstman" }}</span>
          <a href="{{ post.url }}" class="text-xs font-bold text-primary hover:text-primary/80 transition-colors flex items-center gap-1">
            Read Article
            <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
          </a>
        </div>
      </article>
    {%- endfor -%}
  </div>
</section>
