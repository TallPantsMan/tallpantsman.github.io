<!-- Form Submission JavaScript with Mailto Fallback -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('marketing-form');
    const container = document.getElementById('form-container');
    const submitBtn = document.getElementById('submit-btn');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const accessKey = form.elements['access_key'].value;
      const emailVal = form.elements['email'].value;
      const compSizeVal = form.elements['company_size'].value;

      // Check if user has updated the key placeholder
      if (accessKey === 'YOUR_ACCESS_KEY_HERE' || accessKey.trim() === '') {
        // Intercept and do mailto fallback
        const subject = encodeURIComponent('New B2B Session Booking - CaulHaus Marketing');
        const body = encodeURIComponent(`Hello CaulHaus,\n\nI would like to book a B2B marketing strategy session.\n\nWork Email: ${emailVal}\nCompany Size: ${compSizeVal}\n\n(Note: Form submitted via mailto fallback because Web3Forms access key is not yet configured in local files)`);
        
        alert('Notice: The Web3Forms access key is not yet configured by the developer. Opening your default email client with your form details so your session inquiry is sent successfully!');
        window.location.href = `mailto:hello@caulhaus.com?subject=${subject}&body=${body}`;
        
        container.innerHTML = `
          <div class="text-center py-8">
            <span class="material-symbols-outlined text-emerald-500 text-5xl mb-4 animate-bounce">mail</span>
            <h3 class="text-xl font-bold text-on-surface mb-2 animate-pulse">Email Client Opened!</h3>
            <p class="text-on-surface-variant text-sm font-light mb-6">
              Your inquiry has been compiled. Please send the pre-filled email opened on your computer.
            </p>
            <a href="/marketing/" class="text-primary font-semibold hover:underline">Go Back</a>
          </div>
        `;
        return;
      }

      // Normal AJAX submission
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending Request...';
      submitBtn.style.opacity = '0.7';

      const formData = new FormData(form);
      const dataObj = Object.fromEntries(formData.entries());

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(dataObj)
        });

        if (response.ok) {
          container.innerHTML = `
            <div class="text-center py-8">
              <span class="material-symbols-outlined text-emerald-500 text-5xl mb-4">check_circle</span>
              <h3 class="text-xl font-bold text-on-surface mb-2">Session Booked!</h3>
              <p class="text-on-surface-variant text-sm font-light mb-6">
                Thank you. We will review your company profile (${compSizeVal}) and email you back within 24 hours to schedule.
              </p>
              <a href="/" class="text-primary font-semibold hover:underline">Return Home</a>
            </div>
          `;
        } else {
          throw new Error('Submit failed');
        }
      } catch (err) {
        alert('Submission failed. Directing to hello@caulhaus.com.');
        window.location.href = `mailto:hello@caulhaus.com?subject=B2B Marketing Session Request&body=Email: ${emailVal}%0D%0ACompany Size: ${compSizeVal}`;
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit Request';
        submitBtn.style.opacity = '1';
      }
    });
  });
</script>
