<script>
  function updateCalc() {
    const needInput = document.querySelector('input[name="calc-need"]:checked');
    const teamInput = document.querySelector('input[name="calc-team"]:checked');
    const need = needInput ? needInput.value : 'strategy';
    const team = teamInput ? teamInput.value : 'small';
    const checkedAreas = document.querySelectorAll('input[name="calc-areas"]:checked').length;

    let path = "Systems & Strategy Audit";
    let timeline = "2 Weeks";

    if (team === 'enterprise' || checkedAreas >= 4) {
      path = "Ongoing Support";
      timeline = "Ongoing Monthly Sprints";
    } else if (team === 'large' || checkedAreas >= 2 || need === 'both') {
      path = "Strategy & System Build";
      timeline = "4 - 6 Weeks";
    }

    const pathEl = document.getElementById('calc-output-path');
    const timelineEl = document.getElementById('calc-output-timeline');
    if (pathEl) pathEl.textContent = path;
    if (timelineEl) timelineEl.textContent = timeline;

    document.querySelectorAll('input[name="calc-need"]').forEach(input => {
      const parent = input.closest('label');
      if (input.checked) {
        parent.className = "calc-radio-card flex flex-col items-center justify-center p-3.5 rounded-xl border-2 border-brand-indigo bg-brand-indigo/5 cursor-pointer transition-all focus-within:ring-2 focus-within:ring-brand-indigo/30";
      } else {
        parent.className = "calc-radio-card flex flex-col items-center justify-center p-3.5 rounded-xl border border-outline-variant/40 hover:bg-surface-gray cursor-pointer transition-all focus-within:ring-2 focus-within:ring-brand-indigo/30";
      }
    });

    document.querySelectorAll('input[name="calc-team"]').forEach(input => {
      const parent = input.closest('label');
      if (input.checked) {
        parent.className = "calc-radio-card flex flex-col items-center justify-center p-3.5 rounded-xl border-2 border-brand-indigo bg-brand-indigo/5 cursor-pointer transition-all focus-within:ring-2 focus-within:ring-brand-indigo/30";
      } else {
        parent.className = "calc-radio-card flex flex-col items-center justify-center p-3.5 rounded-xl border border-outline-variant/40 hover:bg-surface-gray cursor-pointer transition-all focus-within:ring-2 focus-within:ring-brand-indigo/30";
      }
    });

    document.querySelectorAll('input[name="calc-areas"]').forEach(input => {
      const parent = input.closest('label');
      if (input.checked) {
        parent.className = "calc-check-card flex items-center gap-2.5 p-3 rounded-xl border-2 border-brand-indigo bg-brand-indigo/5 cursor-pointer transition-all focus-within:ring-2 focus-within:ring-brand-indigo/30";
      } else {
        parent.className = "calc-check-card flex items-center gap-2.5 p-3 rounded-xl border border-outline-variant/40 hover:bg-surface-gray cursor-pointer transition-all focus-within:ring-2 focus-within:ring-brand-indigo/30";
      }
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    updateCalc();
  });
</script>
