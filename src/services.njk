<script>
  function updateCalc() {
    // Get inputs
    const crm = document.querySelector('input[name="calc-crm"]:checked').value;
    const volume = document.querySelector('input[name="calc-volume"]:checked').value;
    const checkedTools = document.querySelectorAll('input[name="calc-tools"]:checked').length;

    let path = "System Review";
    let timeline = "2 Weeks";

    if (volume === 'enterprise' || checkedTools >= 4) {
      path = "Ongoing System Support";
      timeline = "Ongoing monthly support";
    } else if (volume === 'high' || checkedTools >= 2 || crm === 'salesforce') {
      path = "Custom System Setup";
      timeline = "4 to 6 Weeks";
    }

    document.getElementById('calc-output-path').textContent = path;
    document.getElementById('calc-output-timeline').textContent = timeline;

    // Highlight selected inputs visually
    document.querySelectorAll('input[name="calc-crm"]').forEach(input => {
      const parent = input.closest('label');
      if (input.checked) {
        parent.className = "flex flex-col items-center p-3 rounded-xl border-2 border-brand-indigo bg-brand-indigo/5 cursor-pointer transition-all";
      } else {
        parent.className = "flex flex-col items-center p-3 rounded-xl border border-glass-stroke hover:bg-surface-gray cursor-pointer transition-all";
      }
    });

    document.querySelectorAll('input[name="calc-volume"]').forEach(input => {
      const parent = input.closest('label');
      if (input.checked) {
        parent.className = "flex flex-col items-center p-3 rounded-xl border-2 border-brand-indigo bg-brand-indigo/5 cursor-pointer transition-all";
      } else {
        parent.className = "flex flex-col items-center p-3 rounded-xl border border-glass-stroke hover:bg-surface-gray cursor-pointer transition-all";
      }
    });

    document.querySelectorAll('input[name="calc-tools"]').forEach(input => {
      const parent = input.closest('label');
      if (input.checked) {
        parent.className = "flex items-center gap-2 p-3 rounded-xl border-2 border-brand-indigo bg-brand-indigo/5 cursor-pointer transition-all";
      } else {
        parent.className = "flex items-center gap-2 p-3 rounded-xl border border-glass-stroke hover:bg-surface-gray cursor-pointer transition-all";
      }
    });
  }

  // Run on page load
  document.addEventListener('DOMContentLoaded', () => {
    updateCalc();
  });
</script>
