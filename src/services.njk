<script>
  function updateCalc() {
    const need = document.querySelector('input[name="calc-need"]:checked').value;
    const team = document.querySelector('input[name="calc-team"]:checked').value;
    const checkedAreas = document.querySelectorAll('input[name="calc-areas"]:checked').length;

    let path = "Systems & Strategy Audit";
    let timeline = "2 Weeks";

    if (team === 'enterprise' || checkedAreas >= 4) {
      path = "Ongoing Support";
      timeline = "Ongoing Monthly Sprints";
    } else if (team === 'large' || checkedAreas >= 2 || need === 'both') {
      path = "Strategy & System Build";
      timeline = "4 - 6 Weeks";
    }

    document.getElementById('calc-output-path').textContent = path;
    document.getElementById('calc-output-timeline').textContent = timeline;

    document.querySelectorAll('input[name="calc-need"]').forEach(input => {
      const parent = input.closest('label');
      if (input.checked) {
        parent.className = "flex flex-col items-center p-3 rounded-xl border border-brand-indigo bg-brand-indigo/5 cursor-pointer transition-all";
      } else {
        parent.className = "flex flex-col items-center p-3 rounded-xl border border-glass-stroke hover:bg-surface-gray cursor-pointer transition-all";
      }
    });

    document.querySelectorAll('input[name="calc-team"]').forEach(input => {
      const parent = input.closest('label');
      if (input.checked) {
        parent.className = "flex flex-col items-center p-3 rounded-xl border border-brand-indigo bg-brand-indigo/5 cursor-pointer transition-all";
      } else {
        parent.className = "flex flex-col items-center p-3 rounded-xl border border-glass-stroke hover:bg-surface-gray cursor-pointer transition-all";
      }
    });

    document.querySelectorAll('input[name="calc-areas"]').forEach(input => {
      const parent = input.closest('label');
      if (input.checked) {
        parent.className = "flex items-center gap-2 p-3 rounded-xl border border-brand-indigo bg-brand-indigo/5 cursor-pointer transition-all";
      } else {
        parent.className = "flex items-center gap-2 p-3 rounded-xl border border-glass-stroke hover:bg-surface-gray cursor-pointer transition-all";
      }
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    updateCalc();
  });
</script>
