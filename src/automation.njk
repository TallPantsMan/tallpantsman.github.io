<script>
(function() {
  const tools = [
    { id: 'sheets', name: 'Google Sheets & Docs', icon: 'table_chart', default: true },
    { id: 'slack', name: 'Slack / Teams', icon: 'forum', default: true },
    { id: 'hubspot', name: 'HubSpot CRM', icon: 'group', default: true },
    { id: 'salesforce', name: 'Salesforce', icon: 'cloud', default: false },
    { id: 'airtable', name: 'Airtable', icon: 'grid_view', default: false },
    { id: 'jira', name: 'Jira / Linear', icon: 'check_circle', default: false },
    { id: 'stripe', name: 'Stripe / Billing', icon: 'payments', default: false },
    { id: 'webhooks', name: 'Custom APIs / Webhooks', icon: 'webhook', default: false }
  ];

  const recipes = [
    {
      id: 'capacity-rollup',
      requires: ['sheets', 'slack'],
      title: 'Automated Capacity & Status Rollup',
      desc: 'Aggregates weekly workloads from departmental sheets and pushes automated team allocation summaries and overload alerts into Slack channels.',
      tags: ['Google Apps Script', 'Slack Bot API'],
      hours: 12
    },
    {
      id: 'lead-routing',
      requires: ['hubspot', 'slack'],
      title: 'Instant Inbound Lead Routing',
      desc: 'When an inbound form is submitted, checks sales rep availability, assigns the deal, and posts instant notification with full lead context directly to rep Slack.',
      tags: ['HubSpot Webhooks', 'Slack Alerts'],
      hours: 14
    },
    {
      id: 'crm-sheets-sync',
      requires: ['sheets', 'hubspot'],
      title: 'CRM Pipeline to Sheets Ledger Sync',
      desc: 'Synchronizes deal stage changes, forecast amounts, and contract dates directly into Google Sheets in real-time, eliminating manual CSV exports.',
      tags: ['Two-Way Sync', 'OAuth REST API'],
      hours: 16
    },
    {
      id: 'salesforce-sheets-sync',
      requires: ['sheets', 'salesforce'],
      title: 'Salesforce Pipeline Sync to Google Sheets',
      desc: 'Extracts Salesforce opportunity changes and account records into Google Sheets dashboards for operational planning without extra seat licenses.',
      tags: ['Salesforce REST API', 'Google Apps Script'],
      hours: 18
    },
    {
      id: 'salesforce-slack-routing',
      requires: ['salesforce', 'slack'],
      title: 'Salesforce Milestone Notifications',
      desc: 'Alerts key account teams in Slack when enterprise opportunities change stage, renewal dates approach, or contracts close.',
      tags: ['Outbound Messaging', 'Slack Webhooks'],
      hours: 12
    },
    {
      id: 'stripe-invoicing',
      requires: ['stripe', 'sheets'],
      title: 'Closed-Deal Invoicing & Revenue Ledger',
      desc: 'Triggers Stripe invoice creation as soon as projects hit billing milestones in Google Sheets and logs transaction confirmation automatically.',
      tags: ['Stripe API', 'Google Apps Script'],
      hours: 10
    },
    {
      id: 'jira-slack-handoff',
      requires: ['jira', 'slack'],
      title: 'Engineering Blocker & Ticket Handoff Alerts',
      desc: 'Routes engineering and ticket status updates directly to account managers in Slack when project blockers are raised.',
      tags: ['Jira Webhooks', 'Slack Integration'],
      hours: 10
    },
    {
      id: 'jira-sheets-sync',
      requires: ['jira', 'sheets'],
      title: 'Sprint Velocity & Client Deliverables Mirror',
      desc: 'Aggregates issue completion status from Jira into client-facing Google Sheets project trackers without giving clients Jira workspace access.',
      tags: ['Jira REST API', 'Sheets API'],
      hours: 15
    },
    {
      id: 'airtable-sheets-bridge',
      requires: ['airtable', 'sheets'],
      title: 'Airtable to Google Workspace Continuous Bridge',
      desc: 'Mirrors relational Airtable bases into Google Sheets for company-wide reporting, avoiding per-seat Airtable enterprise upgrades.',
      tags: ['Airtable API', 'Google Apps Script'],
      hours: 12
    },
    {
      id: 'webhook-custom-api',
      requires: ['webhooks', 'sheets'],
      title: 'Custom Inbound Webhook Listener & Normalizer',
      desc: 'Receives event payloads from proprietary internal apps, sanitizes and formats the payload, and commits structured records to Google Sheets.',
      tags: ['Apps Script Web App', 'JSON Normalizer'],
      hours: 14
    }
  ];

  let activeTools = new Set(tools.filter(t => t.default).map(t => t.id));

  function renderButtons() {
    const grid = document.getElementById('tool-buttons-grid');
    if (!grid) return;
    grid.innerHTML = '';

    tools.forEach(tool => {
      const isSelected = activeTools.has(tool.id);
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.onclick = () => toggleTool(tool.id);
      btn.className = `p-3.5 rounded-2xl border text-left transition-all duration-200 cursor-pointer flex items-center gap-3 ${
        isSelected
          ? 'border-2 border-electric-blue bg-electric-blue/5 shadow-xs'
          : 'border-outline-variant/60 bg-white hover:border-outline-variant hover:bg-surface-gray/50'
      }`;

      btn.innerHTML = `
        <span class="material-symbols-outlined text-lg ${isSelected ? 'text-electric-blue' : 'text-slate-400'}">${tool.icon}</span>
        <div class="flex-grow min-w-0">
          <span class="text-xs font-bold block truncate ${isSelected ? 'text-deep-charcoal' : 'text-slate-600'}">${tool.name}</span>
        </div>
        <span class="w-4 h-4 rounded-full flex items-center justify-center text-[10px] shrink-0 font-bold ${
          isSelected ? 'bg-electric-blue text-white' : 'border border-outline-variant text-transparent'
        }">&check;</span>
      `;
      grid.appendChild(btn);
    });
  }

  function renderRecipes() {
    const container = document.getElementById('recipes-container');
    const emptyMsg = document.getElementById('empty-stack-message');
    const countEl = document.getElementById('selected-tools-count');
    const hoursEl = document.getElementById('stack-hours-saved');
    const ctaBtn = document.getElementById('stack-contact-cta');
    const summaryText = document.getElementById('stack-summary-text');

    if (!container || !emptyMsg) return;

    countEl.textContent = `${activeTools.size} selected`;

    const matching = recipes.filter(r => r.requires.every(req => activeTools.has(req)));

    if (matching.length === 0) {
      container.innerHTML = '';
      emptyMsg.classList.remove('hidden');
      hoursEl.textContent = '0 hrs/mo';
      summaryText.textContent = 'Select complementary tools above to see automation recipes.';
    } else {
      emptyMsg.classList.add('hidden');
      const totalHours = matching.reduce((sum, r) => sum + r.hours, 0);
      hoursEl.textContent = `~${totalHours} hrs/mo`;
      summaryText.textContent = `Found ${matching.length} custom automations for your current stack:`;

      container.innerHTML = matching.map(r => `
        <div class="p-5 bg-surface-gray rounded-2xl border border-outline-variant/40 flex flex-col justify-between hover:border-electric-blue/30 transition-colors">
          <div>
            <div class="flex justify-between items-start gap-2 mb-2">
              <h4 class="font-headline-md text-sm font-bold text-deep-charcoal">${r.title}</h4>
              <span class="font-mono-metric font-bold text-xs text-emerald-600 bg-emerald-500/10 px-2 py-0.5 rounded shrink-0">~${r.hours} hrs/mo</span>
            </div>
            <p class="text-xs text-slate-gray font-light leading-relaxed mb-4">${r.desc}</p>
          </div>
          <div class="flex flex-wrap gap-1.5 pt-2 border-t border-outline-variant/20">
            ${r.tags.map(t => `<span class="px-2 py-0.5 rounded bg-white border border-outline-variant/30 text-slate-600 font-mono-label text-[10px] font-medium">${t}</span>`).join('')}
          </div>
        </div>
      `).join('');
    }

    if (ctaBtn) {
      const toolNames = Array.from(activeTools).join(',');
      ctaBtn.href = `/contact/?stack=${encodeURIComponent(toolNames)}`;
    }
  }

  window.toggleTool = function(toolId) {
    if (activeTools.has(toolId)) {
      activeTools.delete(toolId);
    } else {
      activeTools.add(toolId);
    }
    renderButtons();
    renderRecipes();
  };

  window.resetStackTools = function() {
    activeTools = new Set(['sheets', 'slack', 'hubspot']);
    renderButtons();
    renderRecipes();
  };

  renderButtons();
  renderRecipes();
})();
</script>

