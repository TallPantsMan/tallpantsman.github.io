<script>
  function toggleWorkflow(state) {
    const flowBefore = document.getElementById('flow-before');
    const flowAfter = document.getElementById('flow-after');
    const tabBefore = document.getElementById('tab-before');
    const tabAfter = document.getElementById('tab-after');

    if (state === 'before') {
      flowBefore.classList.remove('hidden');
      flowBefore.classList.add('animate-fade-in');
      flowAfter.classList.add('hidden');
      flowAfter.classList.remove('animate-fade-in');
      
      tabBefore.className = "px-4 py-1.5 rounded-full text-[10px] font-mono-label font-bold transition-all bg-white text-deep-charcoal shadow-xs cursor-pointer focus:outline-none";
      tabAfter.className = "px-4 py-1.5 rounded-full text-[10px] font-mono-label font-medium transition-all bg-transparent text-slate-gray hover:text-deep-charcoal cursor-pointer focus:outline-none";
    } else {
      flowBefore.classList.add('hidden');
      flowBefore.classList.remove('animate-fade-in');
      flowAfter.classList.remove('hidden');
      flowAfter.classList.add('animate-fade-in');
      
      tabBefore.className = "px-4 py-1.5 rounded-full text-[10px] font-mono-label font-medium transition-all bg-transparent text-slate-gray hover:text-deep-charcoal cursor-pointer focus:outline-none";
      tabAfter.className = "px-4 py-1.5 rounded-full text-[10px] font-mono-label font-bold transition-all bg-white text-deep-charcoal shadow-xs cursor-pointer focus:outline-none";
    }
  }
</script>

