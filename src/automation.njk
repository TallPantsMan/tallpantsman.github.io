<!-- ROI Calculator Logic -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const employeesInput = document.getElementById('employees');
    const hoursInput = document.getElementById('hours');
    const rateInput = document.getElementById('rate');

    const employeesVal = document.getElementById('employees-val');
    const hoursVal = document.getElementById('hours-val');
    const rateVal = document.getElementById('rate-val');

    const outWastedHours = document.getElementById('out-wasted-hours');
    const outMonthlyLoss = document.getElementById('out-monthly-loss');
    const outAnnualLoss = document.getElementById('out-annual-loss');
    const outSavings = document.getElementById('out-savings');
    const outReclaimedHours = document.getElementById('out-reclaimed-hours');

    function formatCurrency(val) {
      return new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: 'USD',
        maximumFractionDigits: 0
      }).format(val);
    }

    function formatNumber(val) {
      return new Intl.NumberFormat('en-US').format(val);
    }

    function recalculate() {
      const emp = parseInt(employeesInput.value);
      const hrs = parseInt(hoursInput.value);
      const rate = parseInt(rateInput.value);

      // Update labels
      employeesVal.textContent = emp;
      hoursVal.textContent = hrs;
      rateVal.textContent = `$${rate}`;

      // Calculate formulas
      const annualHoursWasted = emp * hrs * 52;
      const annualLossVal = annualHoursWasted * rate;
      const monthlyLossVal = annualLossVal / 12;
      const annualSavingsVal = annualLossVal * 0.8;
      const hoursReclaimedVal = annualHoursWasted * 0.8;

      // Update display outputs
      outWastedHours.textContent = `${formatNumber(annualHoursWasted)} hrs`;
      outMonthlyLoss.textContent = formatCurrency(monthlyLossVal);
      outAnnualLoss.textContent = formatCurrency(annualLossVal);
      outSavings.textContent = formatCurrency(annualSavingsVal);
      outReclaimedHours.textContent = `Reclaiming ${formatNumber(hoursReclaimedVal)} operator hours annually`;
    }

    // Attach listeners
    employeesInput.addEventListener('input', recalculate);
    hoursInput.addEventListener('input', recalculate);
    rateInput.addEventListener('input', recalculate);

    // Initial run
    recalculate();
  });
</script>
