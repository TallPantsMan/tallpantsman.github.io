<script>
  function toggleWorkflow(state) {
    if (state === 'before') {
      document.getElementById('flow-before').classList.remove('hidden');
      document.getElementById('flow-after').classList.add('hidden');
      document.getElementById('tab-before').className = "px-4 py-1.5 rounded-full text-[10px] font-label-caps font-bold transition-all bg-white text-primary shadow-sm cursor-pointer";
      document.getElementById('tab-after').className = "px-4 py-1.5 rounded-full text-[10px] font-label-caps font-medium transition-all bg-transparent text-on-surface-variant hover:text-primary cursor-pointer";
    } else {
      document.getElementById('flow-before').classList.add('hidden');
      document.getElementById('flow-after').classList.remove('hidden');
      document.getElementById('tab-before').className = "px-4 py-1.5 rounded-full text-[10px] font-label-caps font-medium transition-all bg-transparent text-on-surface-variant hover:text-primary cursor-pointer";
      document.getElementById('tab-after').className = "px-4 py-1.5 rounded-full text-[10px] font-label-caps font-bold transition-all bg-white text-primary shadow-sm cursor-pointer";
    }
  }
</script>

