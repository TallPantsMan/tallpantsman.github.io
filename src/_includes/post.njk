---
layout: base.njk
---
<div class="max-w-container-max-width mx-auto px-grid-margin py-12 md:py-20 reveal active">
  <div class="max-w-3xl mx-auto">
    <a href="/blog/" class="inline-flex items-center text-slate-gray font-mono-label text-mono-label uppercase tracking-wider font-bold mb-10 hover:text-electric-blue transition-colors relative z-10">
      <span class="material-symbols-outlined mr-2 text-[16px]">arrow_back</span>
      Back to Insights
    </a>
    
    <header class="mb-12">
      <div class="flex items-center gap-4 mb-6">
        <time class="font-mono-label text-mono-label text-slate-gray uppercase tracking-wider block">{{ date | readableDate }}</time>
        {% if categories %}
          <span class="inline-block px-3 py-1 rounded-full bg-primary-fixed text-electric-blue font-mono-label text-[10px] uppercase tracking-wider font-bold">{{ categories }}</span>
        {% endif %}
      </div>
      <h1 class="font-display-sm text-display-sm md:text-[52px] md:leading-[1.15] font-bold text-deep-charcoal mb-8 tracking-tight">{{ title }}</h1>
      
      {% if author %}
        <div class="flex items-center gap-3 pt-6 border-t border-outline-variant/30">
          <div class="w-10 h-10 rounded-full bg-electric-blue flex items-center justify-center text-white font-bold text-sm">
            {{ author | slice(0,1) }}
          </div>
          <div class="flex flex-col">
            <span class="font-body-md text-sm font-semibold text-deep-charcoal">{{ author }}</span>
            <span class="font-body-md text-xs text-slate-gray">CaulHaus Strategy</span>
          </div>
        </div>
      {% else %}
        <div class="w-full h-px bg-outline-variant/30"></div>
      {% endif %}
    </header>
    
    <article class="prose prose-slate prose-lg max-w-none prose-headings:font-heading prose-headings:font-bold prose-headings:text-deep-charcoal prose-p:font-sans prose-p:font-light prose-p:text-slate-800 prose-p:leading-relaxed prose-a:text-electric-blue prose-a:font-medium prose-a:underline prose-a:underline-offset-4 hover:prose-a:text-deep-charcoal transition-colors prose-blockquote:border-l-electric-blue prose-blockquote:bg-primary-fixed/30 prose-blockquote:px-6 prose-blockquote:py-2 prose-blockquote:rounded-r-lg prose-blockquote:font-normal prose-blockquote:not-italic">
      {{ content | safe }}
    </article>
  </div>
</div>