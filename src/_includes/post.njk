---
layout: base.njk
---
<main class="w-full pt-40 pb-24">
  <article class="prose lg:prose-xl mx-auto px-6 py-8 font-body-md">
    {{ content | safe }}
  </article>
</main>

<style>
  /* =========================================================
     CaulHaus Article Typography & Absolute Readability System
     ========================================================= */

  /* Ensure article body text is ALWAYS rich, crisp, high-contrast charcoal */
  article,
  article p,
  article li,
  article ol,
  article ul,
  article blockquote {
    color: #0f172a !important; /* Deep dark slate-900 */
    line-height: 1.75 !important;
    font-size: 1.125rem !important;
  }

  /* Headings: Jet-black, bold, clear */
  article h1 {
    color: #020617 !important;
    font-weight: 800 !important;
    line-height: 1.2 !important;
    margin-top: 1.5rem !important;
    margin-bottom: 1.25rem !important;
  }
  article h2 {
    color: #090d16 !important;
    font-weight: 800 !important;
    font-size: 1.75rem !important;
    margin-top: 2.5rem !important;
    margin-bottom: 1rem !important;
    border-bottom: 1px solid #e2e8f0 !important;
    padding-bottom: 0.5rem !important;
  }
  article h3 {
    color: #0f172a !important;
    font-weight: 700 !important;
    font-size: 1.35rem !important;
    margin-top: 2rem !important;
    margin-bottom: 0.75rem !important;
  }

  /* Subtitle & byline */
  article em,
  article i {
    color: #475569 !important;
  }

  /* Strong emphasis */
  article strong,
  article b {
    color: #020617 !important;
    font-weight: 700 !important;
  }

  /* Links */
  article a {
    color: #2563eb !important; /* Vivid accessible blue */
    text-decoration: underline !important;
    font-weight: 600 !important;
  }
  article a:hover {
    color: #1d4ed8 !important;
  }

  /* Inline code */
  article :not(pre) > code {
    background-color: #f1f5f9 !important;
    color: #0f172a !important;
    padding: 0.2rem 0.4rem !important;
    border-radius: 0.25rem !important;
    font-size: 0.9em !important;
    border: 1px solid #e2e8f0 !important;
    font-weight: 600 !important;
  }

  /* AEO Direct Answer Box: High-Contrast Midnight Executive Card */
  article .bg-slate-50,
  article [class*="border-electric-blue"] {
    background-color: #0b0f19 !important;
    border: 2px solid #0284c7 !important; /* High-contrast bright sky blue */
    border-radius: 1rem !important;
    padding: 1.5rem !important;
    margin: 2.25rem 0 !important;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.25) !important;
  }
  article .bg-slate-50 p,
  article [class*="border-electric-blue"] p {
    color: #f1f5f9 !important; /* Bright crisp white-slate on dark card */
    line-height: 1.65 !important;
    font-size: 0.95rem !important;
  }
  article .bg-slate-50 strong,
  article [class*="border-electric-blue"] strong {
    color: #ffffff !important;
    font-size: 1.05rem !important;
    font-weight: 700 !important;
  }
  article .bg-slate-50 [class*="text-electric-blue"],
  article [class*="border-electric-blue"] [class*="text-electric-blue"] {
    color: #38bdf8 !important;
    font-weight: 800 !important;
    letter-spacing: 0.05em !important;
  }
  article .bg-slate-50 .material-symbols-outlined,
  article [class*="border-electric-blue"] .material-symbols-outlined {
    color: #38bdf8 !important;
  }

  /* ASCII Architecture & Code Blocks */
  article pre {
    background-color: #070a12 !important;
    border: 1.5px solid #1e293b !important;
    border-radius: 0.75rem !important;
    color: #f1f5f9 !important;
    padding: 1.25rem !important;
    line-height: 1.35 !important;
    font-size: 0.85rem !important;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace !important;
    overflow-x: auto !important;
  }
  article pre code {
    color: #f1f5f9 !important;
    background: transparent !important;
    font-size: inherit !important;
    line-height: inherit !important;
    border: none !important;
    padding: 0 !important;
  }

  /* Data Tables: Polished Executive Matrices */
  article table {
    width: 100% !important;
    border-collapse: separate !important;
    border-spacing: 0 !important;
    border: 1.5px solid #94a3b8 !important;
    border-radius: 0.75rem !important;
    overflow: hidden !important;
    margin: 2.25rem 0 !important;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05) !important;
  }
  article th {
    background-color: #0f172a !important; /* Dark navy table header */
    color: #ffffff !important; /* Pure white text */
    font-weight: 700 !important;
    font-size: 0.875rem !important;
    text-transform: uppercase !important;
    letter-spacing: 0.05em !important;
    padding: 0.875rem 1rem !important;
    border-bottom: 2px solid #0f172a !important;
    border-right: 1px solid #334155 !important;
    text-align: left !important;
  }
  article th:last-child {
    border-right: none !important;
  }
  article td {
    padding: 0.875rem 1rem !important;
    color: #0f172a !important; /* High-contrast dark text */
    font-size: 0.95rem !important;
    font-weight: 500 !important;
    border-bottom: 1px solid #cbd5e1 !important;
    border-right: 1px solid #e2e8f0 !important;
    background-color: #ffffff !important;
  }
  article td:last-child {
    border-right: none !important;
  }
  article tr:last-child td {
    border-bottom: none !important;
  }
  article tr:nth-child(even) td {
    background-color: #f8fafc !important;
  }
</style>
