<script>
  function openDiagram(type) {
    const modal = document.getElementById('diagram-modal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');

    // Hide all modal inner contents
    document.querySelectorAll('.modal-diagram').forEach(d => d.classList.add('hidden'));

    // Show correct visual
    const activeDiagram = document.getElementById('diagram-' + type);
    activeDiagram.classList.remove('hidden');

    let title = "Financial Services Workflow";
    if (type === 'ecommerce') {
      title = "Online Store Sync System";
    }
    document.getElementById('modal-title').textContent = title;
  }

  function closeDiagram() {
    const modal = document.getElementById('diagram-modal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  // Close modal when clicking outside contents
  document.getElementById('diagram-modal').addEventListener('click', (e) => {
    if (e.target === document.getElementById('diagram-modal')) {
      closeDiagram();
    }
  });
</script>
