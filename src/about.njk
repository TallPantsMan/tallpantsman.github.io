<!-- Form Submission JavaScript with Mailto Fallback -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('about-contact-form');
    const container = document.getElementById('about-form-container');
    const submitBtn = document.getElementById('submit-btn');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const accessKey = form.elements['access_key'].value;
      const nameVal = form.elements['name'].value;
      const emailVal = form.elements['email'].value;
      const interestVal = form.elements['interest'].value;
      const messageVal = form.elements['message'].value;

      // Check if user has updated the key placeholder
      if (accessKey === 'YOUR_ACCESS_KEY_HERE' || accessKey.trim() === '') {
        // Intercept and do mailto fallback
        const subject = encodeURIComponent('New B2B Inquire - CaulHaus About & Contact');
        const body = encodeURIComponent(`Hello CaulHaus,\n\nI would like to contact your team.\n\nName: ${nameVal}\nWork Email: ${emailVal}\nService Interest: ${interestVal}\n\nMessage Details:\n${messageVal}\n\n(Note: Form submitted via mailto fallback because Web3Forms access key is not yet configured in local files)`);
        
        alert('Notice: The Web3Forms access key is not yet configured by the developer. Opening your default email client with your form details so your inquiry is sent successfully!');
        window.location.href = `mailto:hello@caulhaus.com?subject=${subject}&body=${body}`;
        
        container.innerHTML = `
          <div class="text-center py-12 animate-fade-in-up">
            <span class="material-symbols-outlined text-emerald-500 text-5xl mb-4 animate-bounce">mail</span>
            <h3 class="text-xl font-bold text-on-surface mb-2 animate-pulse">Email Client Opened!</h3>
            <p class="text-on-surface-variant text-sm font-light mb-6">
              Your inquiry has been compiled. Please send the pre-filled email opened on your computer.
            </p>
            <a href="/about/" class="text-primary font-semibold hover:underline">Go Back</a>
          </div>
        `;
        return;
      }

      // Normal AJAX submission
      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting...';
      submitBtn.style.opacity = '0.7';

      const formData = new FormData(form);
      const dataObj = Object.fromEntries(formData.entries());

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(dataObj)
        });

        if (response.ok) {
          container.innerHTML = `
            <div class="text-center py-12 animate-fade-in-up">
              <span class="material-symbols-outlined text-emerald-500 text-5xl mb-4">check_circle</span>
              <h3 class="text-xl font-bold text-on-surface mb-2">Inquiry Received!</h3>
              <p class="text-on-surface-variant text-sm font-light mb-6">
                Thank you, ${nameVal}. Our team will review your B2B brief and contact you within 24 hours.
              </p>
              <a href="/" class="text-primary font-semibold hover:underline">Return Home</a>
            </div>
          `;
        } else {
          throw new Error('Submit failed');
        }
      } catch (err) {
        alert('Submission failed. Directing to hello@caulhaus.com.');
        window.location.href = `mailto:hello@caulhaus.com?subject=B2B Inquiry&body=Name: ${nameVal}%0D%0AEmail: ${emailVal}%0D%0AInterest: ${interestVal}%0D%0AMessage: ${messageVal}`;
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit Inquiry';
        submitBtn.style.opacity = '1';
      }
    });
  });
</script>
