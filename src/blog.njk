---
layout: base.njk
title: Blog
---
<div class="max-w-container-max-width mx-auto px-grid-margin py-section-padding reveal active">
  <div class="text-center max-w-3xl mx-auto mb-16">
    <h1 class="font-display-sm text-display-sm font-bold text-deep-charcoal mb-4">Latest Insights</h1>
    <p class="font-body-lg text-body-lg text-slate-gray">
      Thoughts on marketing strategy, automation, and the intersection of human creativity and systems engineering.
    </p>
  </div>
  
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {% for post in collections.blog | reverse %}
      <article class="glass-card rounded-2xl p-8 flex flex-col h-full relative overflow-hidden group border border-outline-variant/40 hover:border-electric-blue/30 transition-all duration-300 shadow-sm hover:shadow-lg hover:-translate-y-1">
        <div class="absolute inset-0 bg-gradient-to-br from-primary-fixed/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="relative z-10 flex flex-col h-full">
          <div class="flex items-center justify-between mb-5">
            <time class="font-mono-label text-mono-label text-slate-gray uppercase tracking-wider block">{{ post.date | readableDate }}</time>
            {% if post.data.categories %}
              <span class="inline-block px-3 py-1 rounded-full bg-primary-fixed text-electric-blue font-mono-label text-[10px] uppercase tracking-wider font-bold">{{ post.data.categories }}</span>
            {% endif %}
          </div>
          <h2 class="font-headline-md text-headline-md font-semibold text-deep-charcoal mb-4 group-hover:text-electric-blue transition-colors leading-tight">
            <a href="{{ post.url }}" class="before:absolute before:inset-0">{{ post.data.title }}</a>
          </h2>
          <div class="mt-auto pt-6 flex items-center text-electric-blue font-mono-label text-mono-label uppercase tracking-wider font-bold">
            Read Article
            <span class="material-symbols-outlined ml-2 text-[16px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
          </div>
        </div>
      </article>
    {% endfor %}
  </div>
</div>